{
  "t": "WindowFigma",
  "a": {
    "is-modal": "false",
    "is-movable": "false",
    "has-shadow": "true",
    "title": "Seleccionar Personaje"
  },
  "s": "width: 640px; height: 480px;",
  "k": [
    {
      "t": "DofusVisualElement",
      "n": "content",
      "a": { "gap-value": "4" },
      "s": "padding: 16px; flex: 1; overflow: hidden;",
      "k": [
        {
          "t": "DofusLabel",
          "n": "title",
          "a": { "tabindex": "-1", "text": "Personajes" },
          "c": ["font-title", "text-center"],
          "s": "font-size: 24px; color: var(--text-gold); margin-bottom: 8px;"
        },
        {
          "t": "DofusVisualElement",
          "n": "characterList",
          "a": { "gap-value": "3" },
          "s": "flex: 1; overflow-y: auto; padding: 8px 0;",
          "k": [
            {
              "t": "SlotGrid",
              "n": "slots",
              "a": {
                "gap-value": "3",
                "fixed-column-count": "2",
                "data-count": "6"
              },
              "s": "justify-content: flex-start;",
              "k": [
                {"t": "Slot", "n": "slot1", "a": {}, "s": ""},
                {"t": "Slot", "n": "slot2", "a": {}, "s": ""},
                {"t": "Slot", "n": "slot3", "a": {}, "s": ""},
                {"t": "Slot", "n": "slot4", "a": {}, "s": ""},
                {"t": "Slot", "n": "slot5", "a": {}, "s": ""},
                {"t": "Slot", "n": "slot6", "a": {}, "s": ""}
              ]
            }
          ]
        }
      ]
    },
    {
      "t": "DofusVisualElement",
      "n": "footer",
      "a": { "gap-value": "3" },
      "s": "border-top: 1px solid var(--border-dark); padding: 12px 16px; justify-content: space-between;",
      "k": [
        {
          "t": "DofusButtonCustom",
          "n": "btnBack",
          "a": { "text": "Volver", "main-style": "secondary", "data-action": "disconnect" },
          "s": "font-size: 14px; padding: 10px 20px;"
        },
        {
          "t": "DofusButtonCustom",
          "n": "btnNewCharacter",
          "a": { "text": "Crear Personaje", "main-style": "primary", "data-action": "open-new-character" },
          "s": "font-size: 14px; padding: 10px 20px;"
        },
        {
          "t": "DofusButtonCustom",
          "n": "btnDeleteCharacter",
          "a": { "text": "Borrar Personaje", "main-style": "secondary", "data-action": "open-delete-character" },
          "s": "font-size: 14px; padding: 10px 20px;"
        }
      ]
    }
  ]
}