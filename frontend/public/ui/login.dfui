{
  "t": "WindowFigma",
  "a": {
    "is-modal": "true",
    "is-movable": "false",
    "has-shadow": "true",
    "title": "DreamFus"
  },
  "s": "width: 400px;",
  "k": [
    {
      "t": "DofusVisualElement",
      "n": "content",
      "a": { "gap-value": "4" },
      "s": "padding: 32px;",
      "k": [
        {
          "t": "DofusLabel",
          "n": "title",
          "a": { "tabindex": "-1", "text": "DreamFus Client" },
          "c": ["dfui-window-title", "text-center", "font-title"],
          "s": "font-size: 28px; color: var(--text-gold); margin-bottom: 8px;"
        },
        {
          "t": "DofusLabel",
          "n": "subtitle",
          "a": { "tabindex": "-1", "text": "Iniciar sesión en el servidor Jondo" },
          "c": ["text-center", "text-white-60"],
          "s": "margin-bottom: 24px;"
        },
        {
          "t": "DofusVisualElement",
          "n": "form",
          "a": { "gap-value": "3" },
          "s": "display: flex; flex-direction: column; gap: 16px;",
          "k": [
            {
              "t": "DofusLabel",
              "n": "serverLabel",
              "a": { "tabindex": "-1", "text": "Servidor" },
              "c": ["text-white-80"],
              "s": "font-size: 14px;"
            },
            {
              "t": "TextInput",
              "n": "serverInput",
              "a": { "value": "localhost", "readonly": "true" },
              "s": "width: 100%;"
            },
            {
              "t": "DofusLabel",
              "n": "portLabel",
              "a": { "tabindex": "-1", "text": "Puerto" },
              "c": ["text-white-80"],
              "s": "font-size: 14px;"
            },
            {
              "t": "TextInput",
              "n": "portInput",
              "a": { "value": "5555", "type": "number" },
              "s": "width: 100%;"
            },
            {
              "t": "DofusLabel",
              "n": "userLabel",
              "a": { "tabindex": "-1", "text": "Usuario" },
              "c": ["text-white-80"],
              "s": "font-size: 14px;"
            },
            {
              "t": "TextInput",
              "n": "userInput",
              "a": { "placeholder-text": "keka", "value": "keka" },
              "s": "width: 100%;"
            },
            {
              "t": "DofusLabel",
              "n": "passwordLabel",
              "a": { "tabindex": "-1", "text": "Contraseña" },
              "c": ["text-white-80"],
              "s": "font-size: 14px;"
            },
            {
              "t": "TextInput",
              "n": "passwordInput",
              "a": { "placeholder-text": "test", "value": "test", "type": "password" },
              "s": "width: 100%;"
            }
          ]
        },
        {
          "t": "DofusButtonCustom",
          "n": "connectBtn",
          "a": { "text": "Entrar", "main-style": "primary", "data-action": "connect" },
          "s": "width: 100%; margin-top: 8px; font-size: 16px; padding: 14px;"
        },
        {
          "t": "DofusVisualElement",
          "n": "status",
          "a": { "gap-value": "2" },
          "s": "margin-top: 16px; padding: 12px; border-radius: 8px; text-align: center; display: none;",
          "k": [
            {
              "t": "DofusLabel",
              "n": "statusText",
              "a": { "tabindex": "-1", "text": "" },
              "c": ["text-center"]
            }
          ]
        }
      ]
    }
  ]
}