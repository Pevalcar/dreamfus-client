{
  "t": "WindowFigma",
  "a": {
    "is-modal": "false",
    "is-movable": "true",
    "has-shadow": "true",
    "title": "Test de Protocolo"
  },
  "s": "width: 800px; height: 600px; max-width: 90vw; max-height: 90vh;",
  "k": [
    {
      "t": "DofusVisualElement",
      "n": "content",
      "a": { "gap-value": "3" },
      "c": ["dfui-window-content", "h-full", "flex", "flex-col"],
      "k": [
        {
          "t": "DofusVisualElement",
          "n": "connectionPanel",
          "c": ["flex", "gap-3", "p-4"],
          "s": "background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid var(--border-dark); flex-shrink: 0;",
          "k": [
            {
              "t": "DofusLabel",
              "n": "connLabel",
              "a": { "tabindex": "-1", "text": "Conexión:" },
              "c": ["text-white-80"],
              "s": "font-size: 14px; min-width: 80px;"
            },
            {
              "t": "TextInput",
              "n": "hostInput",
              "a": { "placeholder-text": "localhost", "value": "localhost" },
              "s": "min-width: 150px; max-width: 200px;"
            },
            {
              "t": "DofusLabel",
              "n": "portLabel",
              "a": { "tabindex": "-1", "text": "Puerto:" },
              "c": ["text-white-80"],
              "s": "font-size: 14px; min-width: 60px;"
            },
            {
              "t": "TextInput",
              "n": "portInput",
              "a": { "placeholder-text": "5555", "value": "5555", "type": "number" },
              "s": "min-width: 80px; max-width: 100px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "connectBtn",
              "a": { "text": "Conectar", "main-style": "primary", "data-action": "connect" },
              "s": "min-width: 120px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "disconnectBtn",
              "a": { "text": "Desconectar", "main-style": "secondary", "data-action": "disconnect", "disabled": "true" },
              "s": "min-width: 120px;"
            },
            {
              "t": "DofusLabel",
              "n": "statusText",
              "a": { "tabindex": "-1", "text": "Desconectado" },
              "c": ["text-error", "font-bold"],
              "s": "font-size: 14px; margin-left: auto;"
            }
          ]
        },
        {
          "t": "DofusVisualElement",
          "n": "opcodePanel",
          "c": ["flex", "flex-wrap", "gap-2", "p-4"],
          "s": "background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid var(--border-dark); flex-shrink: 0;",
          "k": [
            {
              "t": "DofusLabel",
              "n": "opcodeLabel",
              "a": { "tabindex": "-1", "text": "OpCodes rápidos:" },
              "c": ["text-white-80"],
              "s": "font-size: 14px; margin-right: 8px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "btnHello",
              "a": { "text": "hello", "main-style": "secondary", "data-action": "send-message", "data-target": "hello" },
              "s": "font-size: 12px; padding: 6px 12px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "btnKnx",
              "a": { "text": "knx", "main-style": "secondary", "data-action": "send-message", "data-target": "knx" },
              "s": "font-size: 12px; padding: 6px 12px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "btnKuf",
              "a": { "text": "kuf", "main-style": "secondary", "data-action": "send-message", "data-target": "kuf" },
              "s": "font-size: 12px; padding: 6px 12px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "btnBibitta",
              "a": { "text": "bibitta", "main-style": "secondary", "data-action": "send-message", "data-target": "bibitta" },
              "s": "font-size: 12px; padding: 6px 12px;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "btnCustom",
              "a": { "text": "Personalizado", "main-style": "secondary", "data-action": "send-custom" },
              "s": "font-size: 12px; padding: 6px 12px;"
            }
          ]
        },
        {
          "t": "DofusVisualElement",
          "n": "customMessagePanel",
          "c": ["flex", "gap-2", "p-4"],
          "s": "background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid var(--border-dark); flex-shrink: 0; display: none;",
          "k": [
            {
              "t": "DofusLabel",
              "n": "opcodeLabel",
              "a": { "tabindex": "-1", "text": "OpCode:" },
              "c": ["text-white-80"],
              "s": "font-size: 14px; min-width: 80px;"
            },
            {
              "t": "TextInput",
              "n": "customOpcode",
              "a": { "placeholder-text": "Nombre del opcode" },
              "s": "flex-1; max-width: 200px;"
            },
            {
              "t": "DofusLabel",
              "n": "payloadLabel",
              "a": { "tabindex": "-1", "text": "Payload (hex):" },
              "c": ["text-white-80"],
              "s": "font-size: 14px; min-width: 100px;"
            },
            {
              "t": "TextInput",
              "n": "customPayload",
              "a": { "placeholder-text": "0x..." },
              "s": "flex-1;"
            },
            {
              "t": "DofusButtonCustom",
              "n": "sendCustomBtn",
              "a": { "text": "Enviar", "main-style": "primary", "data-action": "send-custom-confirm" },
              "s": "min-width: 100px;"
            }
          ]
        },
        {
          "t": "DofusVisualElement",
          "n": "logPanel",
          "c": ["flex-1", "flex", "flex-col", "p-4", "overflow-hidden"],
          "s": "background: rgba(0,0,0,0.3); border-radius: 8px; border: 1px solid var(--border-dark);",
          "k": [
            {
              "t": "DofusVisualElement",
              "n": "logHeader",
              "c": ["flex", "justify-between", "items-center", "mb-3"],
              "k": [
                {
                  "t": "DofusLabel",
                  "n": "logTitle",
                  "a": { "tabindex": "-1", "text": "Registro de Mensajes" },
                  "c": ["text-white-60"],
                  "s": "font-size: 14px;"
                },
                {
                  "t": "DofusButtonCustom",
                  "n": "clearLogBtn",
                  "a": { "text": "Limpiar", "main-style": "secondary", "data-action": "clear-log" },
                  "s": "font-size: 12px; padding: 4px 12px;"
                }
              ]
            },
            {
              "t": "DofusVisualElement",
              "n": "logContainer",
              "c": ["flex-1", "overflow-auto"],
              "s": "font-family: 'Courier New', monospace; font-size: 12px; line-height: 1.5;",
              "k": []
            }
          ]
        }
      ]
    }
  ]
}