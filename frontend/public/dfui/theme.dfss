/* DreamFus Theme - Additional theme variables */
/* This file can be overridden for custom themes */

:root {
    /* Custom theme overrides go here */
    /* Example dark theme variants: */
    --theme-bg-primary: var(--background-dark-100);
    --theme-bg-secondary: var(--background-medium-100);
    --theme-bg-tertiary: var(--background-light-100);
    
    --theme-border-primary: var(--border-dark);
    --theme-border-secondary: var(--border-medium);
    --theme-border-accent: var(--highlight-primary-100);
    
    --theme-text-primary: var(--text-white);
    --theme-text-secondary: var(--text-white-80);
    --theme-text-muted: var(--text-white-40);
    --theme-text-accent: var(--text-gold);
    
    --theme-accent-primary: var(--highlight-primary-100);
    --theme-accent-secondary: var(--highlight-secondary-100);
    
    --theme-success: var(--success);
    --theme-warning: var(--warning);
    --theme-error: var(--error);
    --theme-info: var(--info);
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    :root {
        --border-medium: var(--text-white);
        --background-dark-97: #000;
    }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}