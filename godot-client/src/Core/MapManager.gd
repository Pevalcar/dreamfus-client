# MapManager.gd
# Renders a Dofus map as an isometric TileMapLayer.
# Cell data is a native Godot Resource (MapData) loaded from a .tres file
# generated by tools/alea_to_godot.py. Tiles are procedural PNGs.
#
# Grid: 14 cols x 40 rows, cell id = row * 14 + col.
# Isometric: pixel = [(col - row) * 32, (col + row) * 16]  (tile 64x32),
# which is exactly Godot's isometric layout for tile_size (64, 32).
class_name MapManager
extends Node2D

const COLS := 14
const ROWS := 40
const TILE_SIZE := Vector2i(64, 32)

# ElementType (mirrors GameMap.gd)
const GRASS := 0
const WATER := 1
const WALL := 2
const DOUBT := 3
const METALLIC := 4
const STONE := 5
const SAND := 6
const DIRT := 7

# Default map ID for backward-compatible single-map mode.
const DEFAULT_MAP_ID := 88212759

@export var map_id: int = DEFAULT_MAP_ID
@export var map_coordinates: Vector2i = Vector2i.ZERO  # (PosX, PosY) — takes priority over map_id

var tile_map: TileMapLayer
var _current_data: MapData = null   # keep reference for CharacterNode queries
var _current_map_id: int = 0        # track which map is active


func _ready() -> void:
	tile_map = TileMapLayer.new()
	tile_map.name = "TileMap"
	add_child(tile_map)
	_build_tileset()
	load_map()


func load_map() -> void:
	# Priority: if map_coordinates is set, pick the best variant automatically.
	var id := map_id
	if map_coordinates != Vector2i.ZERO and id == 0:
		id = _pick_best_variant(map_coordinates)
		if id == 0:
			printerr("[MapManager] No map found at coordinates %s" % map_coordinates)
			return
	_load_and_render(id)


func load_map_by_id(id: int) -> void:
	_load_and_render(id)


func load_neighbor(next_map_id: int) -> void:
	"""Load a neighbour map by its map_id (caller already resolved the id)."""
	if next_map_id == 0:
		return
	print("[MapManager] Loading neighbor map %d" % next_map_id)
	_load_and_render(next_map_id)


func get_current_data() -> MapData:
	return _current_data


func get_walkable_set() -> Dictionary:
	"""Returns a Dictionary {cell_id: true} for fast O(1) walkability checks."""
	if _current_data == null:
		return {}
	var result := {}
	for c in _current_data.walkable_cells:
		result[c] = true
	return result


func _load_and_render(id: int) -> void:
	_current_map_id = id
	var bucket := str(id).substr(0, 4)
	var path := "res://assets/maps/%s/%d.tres" % [bucket, id]
	if not FileAccess.file_exists(path):
		printerr("[MapManager] Map resource not found: %s" % path)
		return
	_current_data = load(path)
	if _current_data == null:
		printerr("[MapManager] Failed to load MapData: %s" % path)
		return

	_print_meta(_current_data)
	tile_map.clear()
	var walk_set := {}
	for c in _current_data.walkable_cells:
		walk_set[c] = true

	var placed := 0
	for cell_id in _current_data.fight_cells:
		var type := GRASS
		if walk_set.has(cell_id):
			type = DIRT
		if cell_id in _current_data.blocked_cells:
			type = WALL
		_set_cell(cell_id, type)
		placed += 1
	print("[MapManager] Map %d (%s): %d cells placed (%d walkable, %d blocked)"
		% [id, _current_data.map_coordinades, placed,
		   _current_data.walkable_cells.size(), _current_data.blocked_cells.size()])


func _pick_best_variant(coords: Vector2i) -> int:
	"""Look up _index.json and prefer outdoor maps first."""
	var index_path := "res://assets/maps/_index.json"
	if not FileAccess.file_exists(index_path):
		return 0
	var raw := FileAccess.get_file_as_string(index_path)
	if raw.is_empty():
		return 0
	var index: Dictionary = JSON.parse_string(raw)
	if index == null:
		return 0
	var key := "%d,%d" % [coords.x, coords.y]
	var variants: Array = index.get(key, [])
	if variants.is_empty():
		return 0
	# Prefer outdoor variants (is_outdoor=true in their .tres).
	for vid in variants:
		var vbucket := str(vid).substr(0, 4)
		var vpath := "res://assets/maps/%s/%d.tres" % [vbucket, vid]
		if not FileAccess.file_exists(vpath):
			continue
		var vd: MapData = load(vpath)
		if vd and vd.is_outdoor:
			return vid
	# Fallback: first variant found.
	return variants[0]


func _print_meta(data: MapData) -> void:
	print("[MapManager] meta: pos=%s subArea=%d outdoor=%s nameId=%d flags=%d neighbors=%s"
		% [data.map_coordinades, data.sub_area_id, data.is_outdoor,
		   data.name_id, data.map_flags, data.neighbors])


# Build a TileSet with one atlas source per generated tile PNG.
# The PNG lives in the project; we read it directly so the map renders
# even before the editor has imported assets.
func _build_tileset() -> void:
	var tileset := TileSet.new()
	tileset.tile_shape = TileSet.TILE_SHAPE_ISOMETRIC
	tileset.tile_size = TILE_SIZE
	tileset.tile_layout = TileSet.TILE_LAYOUT_STACKED

	var dir := "res://assets/tiles"
	for tid in range(8):
		var path := "%s/tile_%d.png" % [dir, tid]
		if not FileAccess.file_exists(path):
			printerr("[MapManager] Missing tile: %s" % path)
			continue
		var img := Image.load_from_file(ProjectSettings.globalize_path(path))
		if img == null:
			printerr("[MapManager] Failed to load: %s" % path)
			continue
		var src := TileSetAtlasSource.new()
		src.texture = ImageTexture.create_from_image(img)
		src.texture_region_size = TILE_SIZE
		src.create_tile(Vector2i.ZERO)
		tileset.add_source(src, tid)
	tile_map.tile_set = tileset


# Dofus cell id -> isometric cell coords. Godot's isometric origin makes
# cell (col, row) land exactly on [(col - row) * 32, (col + row) * 16].
func _set_cell(cell_id: int, type: int) -> void:
	var col := cell_id % COLS
	var row := cell_id / COLS
	tile_map.set_cell(Vector2i(col, row), type, Vector2i.ZERO)
